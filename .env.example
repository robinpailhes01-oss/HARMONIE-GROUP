# Noms des variables uniquement. Les valeurs vivent dans Vercel (Production ET Preview), jamais dans un fichier.
HG_PASSWORD=            # mot de passe, 16 caractères minimum
HG_SESSION_SECRET=      # facultatif : 32 caractères aléatoires minimum (sinon le mot de passe signe la session)
HG_TOTP_SECRET=         # clé du code à 6 chiffres : affichée par /connexion/activer-code, à coller ici
HG_TOTP_ENROLL=         # 1 le temps de scanner le QR code sur /connexion/activer-code, puis supprimer
